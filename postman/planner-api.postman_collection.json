                  "pm.response.to.have.status(200);",
                  "const stats = pm.response.json();",
                  "pm.collectionVariables.set(\"workflow_total_before\", stats.total);",
                  "pm.collectionVariables.set(\"workflow_open_before\", stats.open);",
                  "pm.collectionVariables.set(\"workflow_done_before\", stats.done);"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Создать контрольную задачу",
